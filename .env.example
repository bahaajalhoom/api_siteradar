APP_BASE_URL=https://api-siteradar.apps.taqat.academy
FRONTEND_ORIGIN=https://siteradar.site
SERPAPI_API_KEY=
CRAWLER_MAX_PAGES=10000
CRAWLER_MAX_SECONDS=300
## Set this to the mounted persistent disk in production (for example /data).
## Never leave production data on the container filesystem.
DATA_DIR=data
OLLAMA_BASE_URL=https://ollama-qa.apps.taqat.academy
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_ENABLED=true
# Optional gateway authentication; never expose to frontend.
OLLAMA_API_KEY=
